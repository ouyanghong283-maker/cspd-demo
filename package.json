    "acceptance:v8:wbs-budget": "node scripts/acceptance-v8-wbs-budget.mjs",
    "browser:install": "python scripts/install-browser.py",
    "format": "prettier --write src docs README.md",
    "test:guides": "node scripts/browser-guides.mjs",
    "test:v4:browser": "node scripts/browser-v4.mjs",
    "browser:v8:sim-date-risk-rules": "node scripts/browser-v8-sim-date-risk-rules.mjs",
    "acceptance:v8:signing-quote-basis": "node scripts/acceptance-v8-signing-quote-basis.mjs",
    "browser:v8:contract-file-recovery": "node scripts/browser-v8-contract-file-recovery.mjs",
    "browser:v8:wbs-budget": "node scripts/browser-v8-wbs-budget.mjs",
    "browser:v8:plan-warnings": "node scripts/browser-v8-plan-warnings.mjs",
    "browser:v8:plan-gantt": "node scripts/browser-v8-plan-gantt.mjs",
    "acceptance:v8:workspace-migration": "node scripts/acceptance-v8-workspace-migration.mjs",
    "test:v9:contracts": "node --import tsx --test tests/v9-public-contracts.test.ts && node --import tsx scripts/check-v9-public-scenarios.ts",

    "acceptance:v7:departments": "node scripts/acceptance-v7-department-records.mjs",
    "acceptance:v7:extensions": "node scripts/acceptance-v7-quote-extensions.mjs",
    "acceptance:v7:migration": "node scripts/acceptance-v7-workspace-migration.mjs",
    "acceptance:v7:navigation": "node scripts/acceptance-v7-navigation.mjs",
    "acceptance:v8:quote-reference": "node scripts/acceptance-v8-quote-reference.mjs",
    "acceptance:v8:sim-date-risk-rules": "node scripts/acceptance-v8-sim-date-risk-rules.mjs",
    "acceptance:v8:plan-warnings": "node scripts/acceptance-v8-plan-warnings.mjs",
    "acceptance:v8:plan-gantt": "node scripts/acceptance-v8-plan-gantt.mjs",
